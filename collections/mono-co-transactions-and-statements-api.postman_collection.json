        {
          "id": "eab27242-7d6a-413b-a39e-fe7dd4d9dc47",
          "name": "Get transactions",
          "request": {
            "name": "Get transactions",
            "description": {
              "content": "Lists money-in and money-out transactions for a linked account, with optional filters for date range, type, narration, and pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":id",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Start date (DD-MM-YYYY) of the transaction window."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End date (DD-MM-YYYY) of the transaction window."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by transaction type."
                },
                {
                  "disabled": false,
                  "key": "narration",
                  "value": "<string>",
                  "description": "Filter by transaction narration substring."
                },
                {
                  "disabled": false,
                  "key": "paginate",
                  "value": "<boolean>",
                  "description": "Whether to paginate the results."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number when pagination is enabled."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The linked account id returned by the exchange-token endpoint."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
