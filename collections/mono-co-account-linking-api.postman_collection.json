              "raw": "{\n  \"customer\": {\n    \"name\": \"<string>\",\n    \"email\": \"<string>\"\n  },\n  \"meta\": {\n    \"ref\": \"<string>\"\n  },\n  \"scope\": \"<string>\",\n  \"redirect_url\": \"<string>\"\n}",
